{
  "expo": {
    "name": "Adora",
    "slug": "adora",
    "scheme": "adora",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      ["expo-image-picker", { "photosPermission": "Select business photos for your advertisements.", "cameraPermission": "Take business photos for your advertisements.", "microphonePermission": false }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adora.app"
    },
    "android": {
      "package": "com.adora.app"
    }
  }
}
